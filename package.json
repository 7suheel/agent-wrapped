{
  "name": "agent-wrapped",
  "version": "0.1.0",
  "description": "Spotify Wrapped for your AI coding agents. One command, 100% local, a shareable card of your year with Claude Code.",
  "keywords": [
    "claude-code",
    "claude",
    "ai",
    "wrapped",
    "year-in-review",
    "cli",
    "stats",
    "codex",
    "developer-tools"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-wrapped": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "npm run build && node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "demo": "npm run build && node scripts/generate-demo-data.ts && TZ=UTC node dist/cli.js --dir .demo-data --year 2026 --out docs --name example",
    "demo:gif": "npm run build && node scripts/generate-demo-data.ts && vhs docs/demo.tape",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "satori": "0.63.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
